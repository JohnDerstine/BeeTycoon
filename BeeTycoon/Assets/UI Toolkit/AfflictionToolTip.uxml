<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" picking-mode="Ignore" style="flex-grow: 1; width: auto; height: 175px; background-color: rgb(170, 110, 4); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(101, 46, 0); border-right-color: rgb(101, 46, 0); border-top-color: rgb(101, 46, 0); border-bottom-color: rgb(101, 46, 0); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; color: rgb(255, 255, 255); justify-content: center; align-items: center; flex-direction: column; max-height: 175px; min-height: 175px; max-width: none;">
        <ui:Label tabindex="-1" text="Title" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" picking-mode="Ignore" style="color: rgb(255, 255, 255); font-size: 24px; -unity-font-style: bold;" />
        <ui:Label tabindex="-1" text="Source: " parse-escape-sequences="true" display-tooltip-when-elided="true" name="Source" picking-mode="Ignore" style="-unity-font-style: bold; color: rgb(233, 238, 233); font-size: 20px; padding-right: 4px; padding-left: 4px; text-overflow: clip; white-space: nowrap; flex-grow: 0;" />
        <ui:Label tabindex="-1" text="Remedy:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Remedy" picking-mode="Ignore" style="-unity-font-style: bold; color: rgb(233, 238, 233); font-size: 20px; padding-right: 4px; padding-left: 4px; text-overflow: clip; white-space: nowrap;" />
    </ui:VisualElement>
</ui:UXML>
