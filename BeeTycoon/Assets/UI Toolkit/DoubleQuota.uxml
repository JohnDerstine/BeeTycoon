<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.63);">
        <ui:VisualElement name="Root" style="flex-grow: 0; background-color: rgb(207, 134, 44); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgb(255, 182, 0); border-right-color: rgb(255, 182, 0); border-top-color: rgb(255, 182, 0); border-bottom-color: rgb(255, 182, 0); height: 400px; width: 600px;">
            <ui:Label tabindex="-1" text="The Bee&apos;s Knees!" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 56px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-center;" />
            <ui:Label tabindex="-1" text="Due to your overwhelming sucess,&#10;you have been given the option &#10;to double your quota &#10;in exchance for a Tech Token!" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-center; font-size: 18px; color: rgb(255, 255, 255);" />
            <ui:Label tabindex="-1" text="Quota: $100 &gt; $200" parse-escape-sequences="true" display-tooltip-when-elided="true" name="QuotaLabel" style="-unity-text-align: middle-center; color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold; margin-top: 50px;" />
            <ui:VisualElement name="ButtonGroup" style="flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: center;">
                <ui:Button text="   Accept" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Accept" style="background-color: rgb(72, 192, 48); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 33%; height: 60px; font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;" />
                <ui:Button text="Decline" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Decline" style="background-color: rgb(192, 82, 48); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 33%; height: 60px; font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255); justify-content: flex-start; align-items: center; align-self: center; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;" />
                <ui:VisualElement style="flex-grow: 1; position: absolute; width: 32px; height: 32px; background-image: url(&quot;project://database/Assets/Sprites/HiveUpgradeRedo.png?fileID=2800000&amp;guid=cb13e1e9a6d215a4689f4740db577159&amp;type=3#HiveUpgradeRedo&quot;); left: 78px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
