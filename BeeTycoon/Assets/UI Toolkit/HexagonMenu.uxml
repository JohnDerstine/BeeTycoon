                <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TurnCount" style="-unity-text-align: middle-center; align-self: flex-end; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 48px; height: auto; top: -400px; margin-right: 20px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); visibility: hidden;" />
