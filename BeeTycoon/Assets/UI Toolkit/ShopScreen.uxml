<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="BackgroundTint" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0.94); flex-direction: row; justify-content: space-around; padding-right: 200px; flex-wrap: wrap; padding-top: 200px; padding-left: 200px; width: 100%; height: 100%;">
        <ui:Label tabindex="-1" text="Reward Shop" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="position: absolute; top: 50px; align-self: auto; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 96px; left: 600px;" />
        <ui:VisualElement name="RoyalJellies" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/HexBannerUI.png?fileID=2800000&amp;guid=a291cf038b19f2c4ba6790f0a7297ced&amp;type=3#HexBannerUI&quot;); position: absolute; width: 600px; height: 300px; left: 1620px; justify-content: flex-start; align-items: center; flex-direction: row; padding-left: 125px; top: -25px;">
            <ui:Label tabindex="-1" text="0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RJCount" style="-unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255); font-size: 48px;" />
            <ui:VisualElement style="flex-grow: 0; width: 64px; height: 64px; background-image: url(&quot;project://database/Assets/Sprites/Honey_Sprite.png?fileID=2800000&amp;guid=95d9997ccce6aa046898a9e8bd880124&amp;type=3#Honey_Sprite&quot;); -unity-background-image-tint-color: rgb(173, 0, 255);" />
        </ui:VisualElement>
        <ui:Button text="Skip" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Skip" style="position: absolute; left: 1700px; width: 150px; height: 75px; top: 425px; -unity-font-style: bold; background-color: rgb(197, 91, 79); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(137, 11, 0); border-right-color: rgb(137, 11, 0); border-top-color: rgb(137, 11, 0); border-bottom-color: rgb(137, 11, 0); font-size: 32px; overflow: visible;">
            <ui:Label tabindex="-1" text="+3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SkipLabel" style="position: absolute; top: 75px; color: rgb(255, 255, 255); font-size: 36px;" />
            <ui:VisualElement name="SkipIcon" style="flex-grow: 0; position: absolute; width: 64px; height: 64px; left: 75px; top: 75px; background-image: url(&quot;project://database/Assets/Sprites/Honey_Sprite.png?fileID=2800000&amp;guid=95d9997ccce6aa046898a9e8bd880124&amp;type=3#Honey_Sprite&quot;); flex-shrink: 0; overflow: visible; visibility: visible; display: flex;" />
        </ui:Button>
        <ui:Button text="Done" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Done" style="position: absolute; left: 1700px; width: 150px; height: 75px; top: 700px; -unity-font-style: bold; background-color: rgb(97, 197, 79); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(2, 70, 20); border-right-color: rgb(2, 70, 20); border-top-color: rgb(2, 70, 20); border-bottom-color: rgb(2, 70, 20); font-size: 32px;" />
    </ui:VisualElement>
</ui:UXML>
