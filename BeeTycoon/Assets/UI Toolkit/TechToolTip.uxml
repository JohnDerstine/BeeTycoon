<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="base" picking-mode="Ignore" style="flex-grow: 0; width: 200px; height: 200px; background-color: rgb(118, 77, 27); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
        <ui:Label tabindex="-1" text="Adds chance for an upgrade to the bee suit to appear as an option in choice selection screens. Bee suit grants 25% chance to cure a random affliction when harvesting an almost full hive" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Desc" picking-mode="Ignore" style="white-space: normal; -unity-text-align: middle-center; font-size: 16px; color: rgb(255, 255, 255);" />
    </ui:VisualElement>
