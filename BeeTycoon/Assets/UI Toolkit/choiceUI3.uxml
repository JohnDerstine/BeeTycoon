            <CustomVisualElement name="Banner1" style="top: -450px; align-items: center; justify-content: center; width: 55%; height: 175%; -unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Sprites/Test1%201.png?fileID=2800000&amp;guid=1d39928b6315f6446a0d4cf66a580b9c&amp;type=3#Test1 1&quot;); -unity-background-image-tint-color: rgb(128, 128, 128); position: absolute; left: -150px;">
