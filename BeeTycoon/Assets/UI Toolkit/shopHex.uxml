<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ItemContainer" style="flex-grow: 0; flex-shrink: 0; width: 400px; height: 400px; align-items: center; margin-bottom: 50px; -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
        <ui:VisualElement name="Item" style="flex-grow: 0; flex-direction: row; width: 350px; height: 350px; background-image: url(&quot;project://database/Assets/Sprites/ModifierHex.png?fileID=2800000&amp;guid=33887784234d458448cfd601b69d3d9f&amp;type=3#ModifierHex&quot;); flex-shrink: 0; justify-content: center; align-items: center; -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:VisualElement name="Icon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprites/AlfalfaIcon.png?fileID=2800000&amp;guid=b491d685800400e449919c2fe034e79c&amp;type=3#AlfalfaIcon&quot;); width: 160px; height: 160px;" />
        </ui:VisualElement>
        <ui:VisualElement name="CostContainer" style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center;">
            <ui:VisualElement name="Currency" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprites/Honey_Sprite.png?fileID=2800000&amp;guid=95d9997ccce6aa046898a9e8bd880124&amp;type=3#Honey_Sprite&quot;); flex-shrink: 0; width: 64px; height: 64px;" />
            <ui:Label tabindex="-1" text="3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Cost" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 48px; -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
